<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="page-hero" style="background-image:url('<%= pkg.image_url %>')">
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <div class="breadcrumb"><a href="/home">Home</a> → <a href="/packages">Packages</a> → <%= pkg.name %></div>
        <span class="pkg-badge-hero"><%= pkg.category.charAt(0).toUpperCase()+pkg.category.slice(1) %></span>
        <h1><%= pkg.name %></h1>
        <p><i class="fas fa-map-marker-alt"></i> <%= pkg.destination_name %>, <%= pkg.country %></p>
    </div>
</section>

<section class="page-content">
    <div class="container">
        <div class="pkg-detail-layout">

            <!-- Main -->
            <div class="pkg-main">

                <!-- Quick Info Bar -->
                <div class="pkg-quick-info">
                    <div class="qi-item"><i class="fas fa-clock"></i><div><strong><%= pkg.duration_days %> Days</strong><span><%= pkg.duration_nights %> Nights</span></div></div>
                    <div class="qi-item"><i class="fas fa-star" style="color:#f59e0b"></i><div><strong><%= pkg.rating %>/5</strong><span>Rating</span></div></div>
                    <div class="qi-item"><i class="fas fa-users"></i><div><strong>Max <%= pkg.max_travelers %></strong><span>Travelers</span></div></div>
                    <div class="qi-item"><i class="fas fa-layer-group"></i><div><strong><%= pkg.category.charAt(0).toUpperCase()+pkg.category.slice(1) %></strong><span>Category</span></div></div>
                </div>

                <!-- Description -->
                <div class="pkg-section">
                    <h2>About This Package</h2>
                    <p class="pkg-desc"><%= pkg.description %></p>
                </div>

                <!-- Inclusions / Exclusions -->
                <div class="pkg-incl-excl">
                    <div class="pkg-included">
                        <h3><i class="fas fa-check-circle" style="color:#22c55e"></i> What's Included</h3>
                        <ul>
                            <% pkg.included_list.forEach(item => { %>
                            <li><i class="fas fa-check"></i> <%= item.trim() %></li>
                            <% }) %>
                        </ul>
                    </div>
                    <div class="pkg-excluded">
                        <h3><i class="fas fa-times-circle" style="color:#ef4444"></i> Not Included</h3>
                        <ul>
                            <% pkg.excluded_list.forEach(item => { %>
                            <li><i class="fas fa-times"></i> <%= item.trim() %></li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Booking Sidebar -->
            <div class="pkg-sidebar">
                <div class="price-card">
                    <div class="price-card-top">
                        <small>Starting from</small>
                        <div class="price-big">₹<%= Number(pkg.price).toLocaleString('en-IN') %></div>
                        <small>per person</small>
                    </div>
                    <div class="price-calc" id="priceCalc">
                        <label>Number of Travelers</label>
                        <div class="traveler-counter">
                            <button type="button" onclick="changeTravelers(-1)">−</button>
                            <span id="travelerCount">1</span>
                            <button type="button" onclick="changeTravelers(1)">+</button>
                        </div>
                        <div class="total-price">
                            Total: <strong id="totalPrice">₹<%= Number(pkg.price).toLocaleString('en-IN') %></strong>
                        </div>
                    </div>
                    <a href="/booking?package_id=<%= pkg.id %>" class="btn-book w-full" style="text-align:center;display:block">
                        <i class="fas fa-calendar-check"></i> Book This Package
                    </a>
                    <p class="price-note"><i class="fas fa-info-circle"></i> No payment required now. Confirm & pay later.</p>
                </div>

                <div class="pkg-contact-card">
                    <h4>Need Help?</h4>
                    <p>Our travel experts are ready to help you plan your perfect trip.</p>
                    <a href="/contact" class="btn-secondary w-full" style="text-align:center;display:block">
                        <i class="fas fa-envelope"></i> Contact Us
                    </a>
                </div>
            </div>
        </div>

        <!-- Related Packages -->
        <% if (related.length > 0) { %>
        <div class="related-packages">
            <div class="section-heading" style="text-align:left">
                <h2>More Packages in <%= pkg.destination_name %></h2>
            </div>
            <div class="packages-list-grid">
                <% related.forEach(r => { %>
                <div class="package-card">
                    <div class="package-img-wrap">
                        <img src="<%= r.image_url %>" alt="<%= r.name %>" loading="lazy">
                        <span class="package-badge"><%= r.category %></span>
                        <span class="package-rating"><i class="fas fa-star"></i> <%= r.rating %></span>
                    </div>
                    <div class="package-body">
                        <div class="package-dest"><i class="fas fa-map-marker-alt"></i> <%= r.destination_name %></div>
                        <h3><%= r.name %></h3>
                        <div class="package-footer">
                            <div class="package-price"><strong>₹<%= Number(r.price).toLocaleString('en-IN') %></strong></div>
                            <div class="package-actions">
                                <a href="/packages/<%= r.id %>" class="btn-details">Details</a>
                                <a href="/booking?package_id=<%= r.id %>" class="btn-book">Book</a>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>
</section>

<script>
const basePrice = <%= pkg.price %>;
let travelers = 1;
function changeTravelers(delta) {
    travelers = Math.max(1, Math.min(<%= pkg.max_travelers %>, travelers + delta));
    document.getElementById('travelerCount').textContent = travelers;
    const total = (basePrice * travelers).toLocaleString('en-IN');
    document.getElementById('totalPrice').textContent = '₹' + total;
}
</script>

<%- include('partials/footer') %>
