<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="error-page-section">
    <div class="container text-center">
        <div class="error-content">
            <h1 class="error-code" style="color: var(--danger);">500</h1>
            <h2>Server Error</h2>
            <p><%= typeof message !== 'undefined' ? message : 'Something went wrong on our end. Please try again later.' %></p>
            <div class="error-actions">
                <a href="/home" class="btn-primary btn-lg"><i class="fas fa-home"></i> Back to Homepage</a>
            </div>
        </div>
    </div>
</section>

<style>
.error-page-section {
    padding: 100px 24px;
    min-height: calc(100vh - 75px - 300px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-light);
}
.error-content {
    max-width: 580px;
    margin: 0 auto;
}
.error-code {
    font-size: 110px;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 12px;
}
.error-content h2 {
    font-size: 28px;
    margin-bottom: 14px;
}
.error-content p {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
}
.error-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
}
</style>

<%- include('partials/footer') %>
