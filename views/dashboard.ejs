<%- include('partials/head') %>
<%- include('partials/navbar') %>

<% if (success) { %>
<div class="flash-msg flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>
<% if (error) { %>
<div class="flash-msg flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
<% } %>

<section class="dashboard-section">
    <div class="container">

        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <div class="dash-welcome">
                <h1>Welcome back, <span><%= user.full_name.split(' ')[0] %>!</span> ✈️</h1>
                <p>Manage your bookings and account from your personal dashboard.</p>
            </div>
            <a href="/booking" class="btn-primary"><i class="fas fa-plus"></i> New Booking</a>
        </div>

        <!-- Stats -->
        <div class="dash-stats">
            <div class="dash-stat-card">
                <div class="stat-icon" style="background:#eff6ff"><i class="fas fa-ticket-alt" style="color:#3b82f6"></i></div>
                <div><strong><%= stats.total || 0 %></strong><span>Total Bookings</span></div>
            </div>
            <div class="dash-stat-card">
                <div class="stat-icon" style="background:#fefce8"><i class="fas fa-clock" style="color:#f59e0b"></i></div>
                <div><strong><%= stats.pending || 0 %></strong><span>Pending</span></div>
            </div>
            <div class="dash-stat-card">
                <div class="stat-icon" style="background:#f0fdf4"><i class="fas fa-check-circle" style="color:#22c55e"></i></div>
                <div><strong><%= stats.confirmed || 0 %></strong><span>Confirmed</span></div>
            </div>
            <div class="dash-stat-card">
                <div class="stat-icon" style="background:#fdf4ff"><i class="fas fa-flag-checkered" style="color:#a855f7"></i></div>
                <div><strong><%= stats.completed || 0 %></strong><span>Completed</span></div>
            </div>
        </div>

        <div class="dashboard-layout">
            <!-- Sidebar -->
            <aside class="dash-sidebar">
                <ul class="dash-menu">
                    <li class="active"><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                    <li><a href="/dashboard/bookings"><i class="fas fa-ticket-alt"></i> My Bookings</a></li>
                    <li><a href="/dashboard/profile"><i class="fas fa-user-edit"></i> My Profile</a></li>
                    <li><a href="/booking"><i class="fas fa-plus-circle"></i> New Booking</a></li>
                    <li><a href="/packages"><i class="fas fa-box"></i> Browse Packages</a></li>
                    <li class="dash-divider"></li>
                    <li><a href="/logout" class="dash-logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </aside>

            <!-- Main Content -->
            <div class="dash-main">

                <!-- Upcoming Trips -->
                <% if (upcoming.length > 0) { %>
                <div class="dash-section">
                    <h2><i class="fas fa-plane-departure"></i> Upcoming Trips</h2>
                    <div class="upcoming-cards">
                        <% upcoming.forEach(b => { %>
                        <div class="upcoming-card">
                            <div class="upcoming-info">
                                <h4><%= b.package_name %></h4>
                                <p><i class="fas fa-map-marker-alt"></i> <%= b.destination_name %></p>
                                <p><i class="fas fa-calendar"></i> <%= new Date(b.travel_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></p>
                            </div>
                            <span class="status-badge status-<%= b.status %>"><%= b.status %></span>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- Recent Bookings -->
                <div class="dash-section">
                    <div class="dash-section-header">
                        <h2><i class="fas fa-history"></i> Recent Bookings</h2>
                        <a href="/dashboard/bookings" class="dash-view-all">View All</a>
                    </div>
                    <% if (bookings.length === 0) { %>
                    <div class="empty-state">
                        <i class="fas fa-ticket-alt"></i>
                        <h3>No bookings yet</h3>
                        <p>Start your first adventure with SkyTour!</p>
                        <a href="/packages" class="btn-primary">Browse Packages</a>
                    </div>
                    <% } else { %>
                    <div class="bookings-table-wrap">
                        <table class="bookings-table">
                            <thead><tr><th>Ref</th><th>Package</th><th>Travel Date</th><th>Travelers</th><th>Total</th><th>Status</th></tr></thead>
                            <tbody>
                            <% bookings.forEach(b => { %>
                            <tr>
                                <td><strong><%= b.booking_ref %></strong></td>
                                <td><%= b.package_name %><br><small style="color:#718096"><%= b.destination_name %></small></td>
                                <td><%= new Date(b.travel_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></td>
                                <td><%= b.num_travelers %></td>
                                <td><strong>₹<%= Number(b.total_price).toLocaleString('en-IN') %></strong></td>
                                <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
                            </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
