<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="error-page-section">
    <div class="container text-center">
        <div class="error-content">
            <h1 class="error-code">404</h1>
            <h2>Oops! Page Not Found</h2>
            <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
            <div class="error-actions">
                <a href="/home" class="btn-primary btn-lg"><i class="fas fa-home"></i> Back to Homepage</a>
                <a href="/packages" class="btn-secondary btn-lg"><i class="fas fa-compass"></i> Explore Packages</a>
            </div>
        </div>
    </div>
</section>

<style>
.error-page-section {
    padding: 100px 24px;
    min-height: calc(100vh - 75px - 300px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-light);
}
.error-content {
    max-width: 580px;
    margin: 0 auto;
}
.error-code {
    font-size: 110px;
    font-weight: 900;
    color: var(--primary);
    line-height: 1;
    margin-bottom: 12px;
    letter-spacing: -2px;
}
.error-content h2 {
    font-size: 28px;
    margin-bottom: 14px;
}
.error-content p {
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 30px;
}
.error-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
}
</style>

<%- include('partials/footer') %>
