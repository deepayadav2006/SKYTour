<%- include('partials/head') %>
<%- include('partials/navbar') %>

<section class="page-hero" style="background-image:url('https://images.unsplash.com/photo-1530789253388-582c481c54b0?w=1600&q=80')">
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <span class="hero-tag"><i class="fas fa-globe-americas"></i> 28+ CURATED TOUR ITINERARIES</span>
        <h1>Explore Tour Packages</h1>
        <p>Hand-crafted travel experiences designed for memories that last a lifetime</p>
    </div>
</section>

<!-- Category Pills Navigation -->
<div class="category-pills-bar">
    <div class="container">
        <div class="pills-scroll">
            <a href="/packages" class="pill-btn <%= (!filters || !filters.category) ? 'active' : '' %>">
                <i class="fas fa-th-large"></i> All Packages
            </a>
            <% [
                { id: 'adventure', name: 'Adventure', icon: 'fa-hiking' },
                { id: 'luxury', name: 'Luxury', icon: 'fa-gem' },
                { id: 'family', name: 'Family', icon: 'fa-users' },
                { id: 'budget', name: 'Budget', icon: 'fa-wallet' },
                { id: 'honeymoon', name: 'Honeymoon', icon: 'fa-heart' },
                { id: 'cultural', name: 'Cultural', icon: 'fa-landmark' }
            ].forEach(cat => { %>
            <a href="/packages?category=<%= cat.id %>" class="pill-btn <%= (filters && filters.category === cat.id) ? 'active' : '' %>">
                <i class="fas <%= cat.icon %>"></i> <%= cat.name %>
            </a>
            <% }) %>
        </div>
    </div>
</div>

<section class="page-content">
    <div class="container">
        <div class="packages-layout">

            <!-- Filters Sidebar -->
            <aside class="filters-sidebar">
                <form method="GET" action="/packages" id="filterForm">
                    <div class="filter-header">
                        <h3><i class="fas fa-sliders-h"></i> Refine Search</h3>
                        <% if (filters && (filters.destination || filters.category || filters.min_price || filters.max_price || filters.sort)) { %>
                        <a href="/packages" class="reset-link">Reset</a>
                        <% } %>
                    </div>

                    <div class="filter-group">
                        <label><i class="fas fa-map-marker-alt"></i> Destination</label>
                        <select name="destination" onchange="this.form.submit()">
                            <option value="">All 14 Destinations</option>
                            <% if (typeof destinations !== 'undefined' && destinations) { %>
                                <% destinations.forEach(d => { %>
                                <option value="<%= d.name %>" <%= (filters && (filters.destination == d.name || filters.destination == d.id)) ? 'selected' : '' %>><%= d.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label><i class="fas fa-layer-group"></i> Category</label>
                        <select name="category" onchange="this.form.submit()">
                            <option value="">All Categories</option>
                            <% ['adventure','luxury','family','budget','honeymoon','cultural'].forEach(c => { %>
                            <option value="<%= c %>" <%= (filters && filters.category === c) ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label><i class="fas fa-rupee-sign"></i> Price Range (₹)</label>
                        <div class="price-inputs-row">
                            <input type="number" name="min_price" value="<%= (filters && filters.min_price) || '' %>" placeholder="Min (₹)" min="0">
                            <span>to</span>
                            <input type="number" name="max_price" value="<%= (filters && filters.max_price) || '' %>" placeholder="Max (₹)" min="0">
                        </div>
                    </div>

                    <div class="filter-group">
                        <label><i class="fas fa-sort-amount-down"></i> Sort By</label>
                        <select name="sort" onchange="this.form.submit()">
                            <option value="">Top Rated & Popular</option>
                            <option value="price_asc" <%= (filters && filters.sort === 'price_asc') ? 'selected' : '' %>>Price: Low to High</option>
                            <option value="price_desc" <%= (filters && filters.sort === 'price_desc') ? 'selected' : '' %>>Price: High to Low</option>
                            <option value="duration" <%= (filters && filters.sort === 'duration') ? 'selected' : '' %>>Duration: Short to Long</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-primary w-full">Apply Filters</button>
                    <a href="/packages" class="btn-secondary w-full" style="text-align:center;display:block;margin-top:10px;">Clear All Filters</a>
                </form>
            </aside>

            <!-- Packages Grid Main -->
            <div class="packages-main">

                <!-- Instant Search Toolbar -->
                <div class="packages-toolbar">
                    <div class="search-input-wrap">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="liveSearchInput" placeholder="Quick search packages (e.g. Goa, Scuba, Luxury, Villa...)" onkeyup="filterPackagesLive(this.value)">
                    </div>
                    <div class="results-counter">
                        <span id="resultsCount"><strong><%= packages.length %></strong> tour packages available</span>
                    </div>
                </div>

                <% if (packages.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-compass fa-3x" style="color:var(--text-muted);margin-bottom:16px;"></i>
                    <h3>No packages found matching your criteria</h3>
                    <p>Try widening your price range or exploring different destination filters.</p>
                    <a href="/packages" class="btn-primary" style="margin-top:14px;">View All 28 Packages</a>
                </div>
                <% } else { %>
                <div class="packages-list-grid" id="packagesGrid">
                    <% packages.forEach(pkg => { %>
                    <div class="package-card"
                         data-name="<%= (pkg.name || pkg.package_name || '').toLowerCase() %>"
                         data-dest="<%= (pkg.destination_name || pkg.destination || '').toLowerCase() %>"
                         data-cat="<%= (pkg.category || '').toLowerCase() %>">
                        <div class="package-img-wrap">
                            <img src="<%= pkg.image_url || pkg.image || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80' %>"
                                 alt="<%= pkg.name || pkg.package_name %>"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80';">
                            <span class="package-badge badge-<%= (pkg.category || 'adventure').toLowerCase() %>">
                                <i class="fas <%=
                                    pkg.category === 'luxury' ? 'fa-gem' :
                                    pkg.category === 'honeymoon' ? 'fa-heart' :
                                    pkg.category === 'family' ? 'fa-users' :
                                    pkg.category === 'budget' ? 'fa-wallet' :
                                    pkg.category === 'cultural' ? 'fa-landmark' :
                                    'fa-hiking'
                                %>"></i>
                                <%= (pkg.category || 'adventure').charAt(0).toUpperCase() + (pkg.category || 'adventure').slice(1) %>
                            </span>
                            <button class="card-wishlist-btn" title="Save to wishlist" onclick="toggleWishlist(event, this, '<%= (pkg.name || pkg.package_name || '').replace(/'/g, "\\'") %>')">
                                <i class="far fa-heart"></i>
                            </button>
                            <span class="package-rating">
                                <i class="fas fa-star"></i> <%= Number(pkg.rating || 4.5).toFixed(1) %>
                            </span>
                        </div>
                        <div class="package-body">
                            <div class="package-dest">
                                <i class="fas fa-map-marker-alt"></i>
                                <%= pkg.destination_name || pkg.destination || 'Popular Destination' %>
                            </div>
                            <h3><%= pkg.name || pkg.package_name %></h3>
                            <p><%= pkg.short_desc || (pkg.description ? pkg.description.substring(0, 100) + '...' : 'Explore this incredible destination with SkyTour.') %></p>
                            <div class="package-meta">
                                <span><i class="fas fa-clock"></i> <%= pkg.duration || (pkg.duration_days + 'D / ' + pkg.duration_nights + 'N') %></span>
                                <span><i class="fas fa-users"></i> Max <%= pkg.max_travelers || 20 %></span>
                            </div>
                            <div class="package-footer">
                                <div class="package-price-wrap">
                                    <span class="price-prefix">Starting from</span>
                                    <div class="price-val-row">
                                        <strong>₹<%= Number(pkg.price || 0).toLocaleString('en-IN') %></strong>
                                        <span class="price-suffix">/ person</span>
                                    </div>
                                </div>
                                <div class="package-btn-grid">
                                    <a href="/packages/<%= pkg.id %>" class="btn-card-details">
                                        <i class="fas fa-info-circle"></i> Details
                                    </a>
                                    <a href="/booking?package_id=<%= pkg.id %>" class="btn-card-book">
                                        <i class="fas fa-bolt"></i> Book Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>

        </div>
    </div>
</section>

<script>
function filterPackagesLive(query) {
    const q = query.toLowerCase().trim();
    const cards = document.querySelectorAll('#packagesGrid .package-card');
    let visibleCount = 0;

    cards.forEach(card => {
        const name = card.dataset.name || '';
        const dest = card.dataset.dest || '';
        const cat = card.dataset.cat || '';

        if (!q || name.includes(q) || dest.includes(q) || cat.includes(q)) {
            card.style.display = 'flex';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });

    const counter = document.getElementById('resultsCount');
    if (counter) {
        counter.innerHTML = `Showing <strong>${visibleCount}</strong> of ${cards.length} tour packages`;
    }
}
</script>

<%- include('partials/footer') %>
