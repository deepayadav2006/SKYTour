<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit Package' : 'Add New Package' %> – SkyTour Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <%- include('sidebar', { activePage: 'packages' }) %>

    <div class="admin-main">
        <%- include('topbar', { pageTitle: isEdit ? `Edit: ${pkg.name}` : 'Create Tour Package' }) %>

        <div class="admin-content">
            <div style="margin-bottom: 20px;">
                <a href="/admin/packages" class="btn-action btn-view"><i class="fas fa-arrow-left"></i> Back to Packages</a>
            </div>

            <div class="admin-card" style="max-width: 900px;">
                <form action="<%= isEdit ? `/admin/packages/edit/${pkg.id}` : '/admin/packages/add' %>" method="POST" class="admin-form">

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Package Title *</label>
                            <input type="text" name="name" value="<%= pkg.name || '' %>" placeholder="e.g. Goa Beach Escape" required>
                        </div>
                        <div class="form-group">
                            <label>Destination *</label>
                            <select name="destination_id" required>
                                <option value="">-- Select Destination --</option>
                                <% destinations.forEach(d => { %>
                                <option value="<%= d.id %>" <%= (pkg.destination_id == d.id) ? 'selected' : '' %>><%= d.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Short Description (1-2 sentences) *</label>
                        <input type="text" name="short_desc" value="<%= pkg.short_desc || '' %>" placeholder="Brief summary shown on package cards" required>
                    </div>

                    <div class="form-group">
                        <label>Full Detailed Description *</label>
                        <textarea name="description" rows="5" placeholder="Detailed itinerary, highlights, and experience..." required><%= pkg.description || '' %></textarea>
                    </div>

                    <div class="form-grid-3">
                        <div class="form-group">
                            <label>Price per Person (₹) *</label>
                            <input type="number" step="0.01" name="price" value="<%= pkg.price || '' %>" placeholder="e.g. 15999" required min="1">
                        </div>
                        <div class="form-group">
                            <label>Duration Days *</label>
                            <input type="number" name="duration_days" value="<%= pkg.duration_days || '' %>" placeholder="4" required min="1">
                        </div>
                        <div class="form-group">
                            <label>Duration Nights *</label>
                            <input type="number" name="duration_nights" value="<%= pkg.duration_nights || '' %>" placeholder="3" required min="0">
                        </div>
                    </div>

                    <div class="form-grid-3">
                        <div class="form-group">
                            <label>Category *</label>
                            <select name="category" required>
                                <% ['adventure','luxury','family','budget','honeymoon','cultural'].forEach(c => { %>
                                <option value="<%= c %>" <%= (pkg.category === c) ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Rating (1.0 to 5.0)</label>
                            <input type="number" step="0.1" name="rating" value="<%= pkg.rating || 4.5 %>" min="1" max="5">
                        </div>
                        <div class="form-group">
                            <label>Max Travelers</label>
                            <input type="number" name="max_travelers" value="<%= pkg.max_travelers || 20 %>" min="1">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Image URL *</label>
                        <input type="url" name="image_url" value="<%= pkg.image_url || '' %>" placeholder="https://images.unsplash.com/..." required>
                        <small style="color: var(--admin-muted); display: block; margin-top: 4px;">Paste a high-resolution Unsplash or hosted image link</small>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Included Services (separate items with | )</label>
                            <textarea name="included" rows="3" placeholder="Hotel accommodation|Daily breakfast|Airport transfers|Sightseeing"><%= pkg.included || '' %></textarea>
                        </div>
                        <div class="form-group">
                            <label>Excluded Services (separate items with | )</label>
                            <textarea name="excluded" rows="3" placeholder="Flights|Lunch & Dinner|Personal expenses"><%= pkg.excluded || '' %></textarea>
                        </div>
                    </div>

                    <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="is_available" id="is_available" value="1" <%= (typeof pkg.is_available === 'undefined' || pkg.is_available) ? 'checked' : '' %> style="width: auto;">
                        <label for="is_available" style="margin-bottom: 0; cursor: pointer;">Package is Active & Available for Booking</label>
                    </div>

                    <div style="display: flex; gap: 12px; margin-top: 24px;">
                        <button type="submit" class="btn-primary btn-lg"><%= isEdit ? 'Save Changes' : 'Create Package' %></button>
                        <a href="/admin/packages" class="btn-secondary btn-lg">Cancel</a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

</body>
</html>
