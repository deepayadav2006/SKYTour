<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tour Packages – SkyTour Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <%- include('sidebar', { activePage: 'packages' }) %>

    <div class="admin-main">
        <%- include('topbar', { pageTitle: 'Tour Package Management' }) %>

        <div class="admin-content">
            <% if (success) { %>
            <div class="admin-alert admin-alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
            <% } %>
            <% if (error) { %>
            <div class="admin-alert admin-alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
            <% } %>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h2><i class="fas fa-box"></i> All Tour Packages (<%= packages.length %>)</h2>
                    <a href="/admin/packages/add" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">
                        <i class="fas fa-plus"></i> Add New Package
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Package Name</th>
                                <th>Destination</th>
                                <th>Duration</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (packages.length === 0) { %>
                            <tr><td colspan="9" style="text-align: center; padding: 40px; color: var(--admin-muted);">No tour packages created yet.</td></tr>
                            <% } %>
                            <% packages.forEach(p => { %>
                            <tr>
                                <td>
                                    <img src="<%= p.image_url %>" alt="<%= p.name %>" class="admin-table-img">
                                </td>
                                <td><strong><%= p.name %></strong></td>
                                <td><i class="fas fa-map-marker-alt" style="color: var(--admin-primary);"></i> <%= p.destination_name %></td>
                                <td><%= p.duration_days %>D / <%= p.duration_nights %>N</td>
                                <td><strong>₹<%= Number(p.price).toLocaleString('en-IN') %></strong></td>
                                <td><span style="text-transform: capitalize; font-size: 12px; background: #f1f5f9; padding: 4px 8px; border-radius: 4px;"><%= p.category %></span></td>
                                <td><i class="fas fa-star" style="color: #f59e0b;"></i> <%= p.rating %></td>
                                <td>
                                    <% if (p.is_available) { %>
                                    <span class="badge-status badge-confirmed">Available</span>
                                    <% } else { %>
                                    <span class="badge-status badge-cancelled">Unavailable</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 6px;">
                                        <a href="/admin/packages/edit/<%= p.id %>" class="btn-action btn-edit"><i class="fas fa-edit"></i> Edit</a>
                                        <form action="/admin/packages/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this tour package?')">
                                            <button type="submit" class="btn-action btn-delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>
