<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Destinations – SkyTour Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <%- include('sidebar', { activePage: 'destinations' }) %>

    <div class="admin-main">
        <%- include('topbar', { pageTitle: 'Destination Management' }) %>

        <div class="admin-content">
            <% if (success) { %>
            <div class="admin-alert admin-alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
            <% } %>
            <% if (error) { %>
            <div class="admin-alert admin-alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
            <% } %>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h2><i class="fas fa-map-marked-alt"></i> All Destinations (<%= destinations.length %>)</h2>
                    <a href="/admin/destinations/add" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">
                        <i class="fas fa-plus"></i> Add New Destination
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Photo</th>
                                <th>Destination Name</th>
                                <th>Country</th>
                                <th>Best Time</th>
                                <th>Climate</th>
                                <th>Currency</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (destinations.length === 0) { %>
                            <tr><td colspan="8" style="text-align: center; padding: 40px; color: var(--admin-muted);">No destinations found.</td></tr>
                            <% } %>
                            <% destinations.forEach(d => { %>
                            <tr>
                                <td>
                                    <img src="<%= d.image_url %>" alt="<%= d.name %>" class="admin-table-img">
                                </td>
                                <td><strong><%= d.name %></strong></td>
                                <td><i class="fas fa-globe" style="color: var(--admin-primary);"></i> <%= d.country %></td>
                                <td><%= d.best_time %></td>
                                <td><%= d.climate %></td>
                                <td><%= d.currency %></td>
                                <td>
                                    <% if (d.is_active) { %>
                                    <span class="badge-status badge-confirmed">Active</span>
                                    <% } else { %>
                                    <span class="badge-status badge-cancelled">Inactive</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 6px;">
                                        <a href="/admin/destinations/edit/<%= d.id %>" class="btn-action btn-edit"><i class="fas fa-edit"></i> Edit</a>
                                        <form action="/admin/destinations/delete/<%= d.id %>" method="POST" onsubmit="return confirm('Delete this destination? Linked packages may also be affected.')">
                                            <button type="submit" class="btn-action btn-delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>
