<aside class="admin-sidebar">
    <div class="admin-logo">
        Sky<span>Tour</span> <span class="badge-admin">ADMIN</span>
    </div>

    <div class="admin-nav">
        <div class="admin-nav-title">Main Menu</div>
        <ul class="admin-nav-list">
            <li class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
                <a href="/admin/dashboard"><i class="fas fa-chart-line"></i> Dashboard</a>
            </li>
            <li class="<%= typeof activePage !== 'undefined' && activePage === 'bookings' ? 'active' : '' %>">
                <a href="/admin/bookings"><i class="fas fa-ticket-alt"></i> Bookings</a>
            </li>
            <li class="<%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
                <a href="/admin/customers"><i class="fas fa-users"></i> Customers</a>
            </li>
        </ul>

        <div class="admin-nav-title">Inventory</div>
        <ul class="admin-nav-list">
            <li class="<%= typeof activePage !== 'undefined' && activePage === 'packages' ? 'active' : '' %>">
                <a href="/admin/packages"><i class="fas fa-box"></i> Tour Packages</a>
            </li>
            <li class="<%= typeof activePage !== 'undefined' && activePage === 'destinations' ? 'active' : '' %>">
                <a href="/admin/destinations"><i class="fas fa-map-marked-alt"></i> Destinations</a>
            </li>
        </ul>
    </div>

    <div class="admin-sidebar-footer">
        <div class="admin-user-pill">
            <div class="admin-avatar"><i class="fas fa-user-shield"></i></div>
            <div class="admin-info">
                <strong><%= typeof admin !== 'undefined' && admin ? admin.full_name : 'Admin User' %></strong>
                <span><%= typeof admin !== 'undefined' && admin ? admin.email : 'admin@skytour.com' %></span>
            </div>
        </div>
    </div>
</aside>
