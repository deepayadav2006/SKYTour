<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Management – SkyTour Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <%- include('sidebar', { activePage: 'bookings' }) %>

    <div class="admin-main">
        <%- include('topbar', { pageTitle: 'Booking Management' }) %>

        <div class="admin-content">
            <% if (success) { %>
            <div class="admin-alert admin-alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
            <% } %>

            <!-- Filters -->
            <div class="admin-card">
                <form method="GET" action="/admin/bookings" class="admin-filter-bar">
                    <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search by Ref #, customer name, email..." style="min-width: 300px;">
                    <select name="status" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                        <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                        <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                    <button type="submit" class="btn-primary" style="padding: 10px 18px;"><i class="fas fa-search"></i> Search</button>
                    <% if (filters.search || filters.status) { %>
                    <a href="/admin/bookings" class="btn-secondary" style="padding: 10px 14px;">Reset</a>
                    <% } %>
                </form>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Ref #</th>
                                <th>Customer</th>
                                <th>Contact</th>
                                <th>Package & Dest</th>
                                <th>Dates</th>
                                <th>Travelers</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bookings.length === 0) { %>
                            <tr>
                                <td colspan="10" style="text-align: center; padding: 40px; color: var(--admin-muted);">
                                    <i class="fas fa-folder-open" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                                    No bookings found matching criteria.
                                </td>
                            </tr>
                            <% } %>
                            <% bookings.forEach(b => { %>
                            <tr>
                                <td><strong>#<%= b.booking_ref %></strong></td>
                                <td>
                                    <strong><%= b.traveler_name %></strong><br>
                                    <small style="color: var(--admin-muted);"><%= b.traveler_email %></small>
                                </td>
                                <td><%= b.traveler_phone %></td>
                                <td>
                                    <%= b.package_name %><br>
                                    <small style="color: var(--admin-primary);"><i class="fas fa-map-marker-alt"></i> <%= b.destination_name %></small>
                                </td>
                                <td>
                                    <%= new Date(b.travel_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
                                    <% if (b.return_date) { %>
                                    <br><small style="color: var(--admin-muted);">to <%= new Date(b.return_date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></small>
                                    <% } %>
                                </td>
                                <td><%= b.num_travelers %> Person(s)</td>
                                <td><strong>₹<%= Number(b.total_price).toLocaleString('en-IN') %></strong></td>
                                <td>
                                    <span class="badge-status badge-<%= b.status %>"><%= b.status %></span>
                                </td>
                                <td>
                                    <span class="badge-status <%= (b.payment_status === 'paid') ? 'badge-confirmed' : 'badge-pending' %>">
                                        <%= (b.payment_mode || 'card').toUpperCase() %>: <%= (b.payment_status || 'pending').toUpperCase() %>
                                    </span>
                                    <% if (b.transaction_id) { %>
                                    <br><small style="font-size:10px;color:var(--admin-muted);font-family:monospace;"><%= b.transaction_id %></small>
                                    <% } %>
                                </td>
                                <td>
                                    <form action="/admin/bookings/<%= b.id %>/status" method="POST" style="display: flex; flex-direction:column; gap: 4px;">
                                        <select name="status" style="padding: 4px 6px; font-size: 11px; border-radius: 4px;">
                                            <option value="pending" <%= b.status === 'pending' ? 'selected' : '' %>>Booking: Pending</option>
                                            <option value="confirmed" <%= b.status === 'confirmed' ? 'selected' : '' %>>Booking: Confirmed</option>
                                            <option value="completed" <%= b.status === 'completed' ? 'selected' : '' %>>Booking: Completed</option>
                                            <option value="cancelled" <%= b.status === 'cancelled' ? 'selected' : '' %>>Booking: Cancelled</option>
                                        </select>
                                        <div style="display:flex;gap:4px;">
                                            <select name="payment_status" style="padding: 4px 6px; font-size: 11px; border-radius: 4px; flex:1;">
                                                <option value="pending" <%= b.payment_status === 'pending' ? 'selected' : '' %>>Pay: Pending</option>
                                                <option value="paid" <%= b.payment_status === 'paid' ? 'selected' : '' %>>Pay: Paid</option>
                                                <option value="refunded" <%= b.payment_status === 'refunded' ? 'selected' : '' %>>Pay: Refunded</option>
                                            </select>
                                            <button type="submit" class="btn-action btn-edit" title="Save Status"><i class="fas fa-check"></i></button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>
