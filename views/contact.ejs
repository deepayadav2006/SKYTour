<%- include('partials/head') %>
<%- include('partials/navbar') %>

<% if (success) { %>
<div class="flash-msg flash-success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>
<% if (error) { %>
<div class="flash-msg flash-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
<% } %>

<section class="page-hero" style="background-image:url('https://images.unsplash.com/photo-1534536281715-e28d76689b4d?w=1600&q=80')">
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
        <h1>Contact Us</h1>
        <p>We're here to answer your questions and help you plan your next trip</p>
    </div>
</section>

<section class="page-content">
    <div class="container">
        <div class="contact-layout">

            <!-- Contact Form -->
            <div class="contact-form-card">
                <h2>Send Us a Message</h2>
                <p>Have a question about a package or need a custom tour? Fill out the form below and our team will get back to you within 24 hours.</p>

                <form action="/contact" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-user"></i> Your Name *</label>
                            <input type="text" name="name" required placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-envelope"></i> Email Address *</label>
                            <input type="email" name="email" required placeholder="you@example.com">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label><i class="fas fa-phone"></i> Phone Number</label>
                            <input type="tel" name="phone" placeholder="+91 98765 43210">
                        </div>
                        <div class="form-group">
                            <label><i class="fas fa-map-marker-alt"></i> Interested Destination</label>
                            <input type="text" name="destination" placeholder="e.g. Bali, Kashmir, Goa">
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-comment"></i> Your Message *</label>
                        <textarea name="message" rows="5" required placeholder="Tell us about your travel dates, group size, and preferences..."></textarea>
                    </div>

                    <button type="submit" class="btn-primary btn-lg w-full">Send Message</button>
                </form>
            </div>

            <!-- Contact Info -->
            <div class="contact-info-wrap">
                <div class="contact-info-card">
                    <h3>Get in Touch</h3>
                    <ul class="contact-items">
                        <li>
                            <div class="ci-icon"><i class="fas fa-map-marker-alt"></i></div>
                            <div>
                                <strong>Our Headquarters</strong>
                                <span>123 Travel Street, Nariman Point, Mumbai 400021, India</span>
                            </div>
                        </li>
                        <li>
                            <div class="ci-icon"><i class="fas fa-phone-alt"></i></div>
                            <div>
                                <strong>Phone Support</strong>
                                <span>+91 98765 43210 / +91 22 2847 9000</span>
                            </div>
                        </li>
                        <li>
                            <div class="ci-icon"><i class="fas fa-envelope"></i></div>
                            <div>
                                <strong>Email Inquiries</strong>
                                <span>hello@skytour.com / bookings@skytour.com</span>
                            </div>
                        </li>
                        <li>
                            <div class="ci-icon"><i class="fas fa-clock"></i></div>
                            <div>
                                <strong>Office Hours</strong>
                                <span>Monday – Saturday: 9:00 AM – 7:00 PM IST</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="faq-card">
                    <h4>Need Immediate Assistance?</h4>
                    <p>Our travel agents are available on WhatsApp for instant quote requests and urgent trip support.</p>
                    <a href="https://wa.me/" target="_blank" class="btn-secondary w-full" style="text-align:center;display:block;">
                        <i class="fab fa-whatsapp" style="color:#25d366"></i> Chat on WhatsApp
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
.contact-layout {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 40px;
}
.contact-form-card {
    background: #fff;
    padding: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
}
.contact-form-card h2 {
    font-size: 26px;
    margin-bottom: 8px;
}
.contact-form-card p {
    color: var(--text-muted);
    font-size: 14px;
    margin-bottom: 24px;
}
.contact-info-card {
    background: #fff;
    padding: 32px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
}
.contact-info-card h3 {
    font-size: 20px;
    margin-bottom: 20px;
}
.contact-items li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
}
.ci-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.contact-items strong {
    display: block;
    font-size: 14px;
    color: var(--navy);
}
.contact-items span {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
}
.faq-card {
    background: #fff;
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
}
.faq-card h4 {
    margin-bottom: 8px;
}
.faq-card p {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 16px;
}
@media (max-width: 768px) {
    .contact-layout { grid-template-columns: 1fr; }
}
</style>

<%- include('partials/footer') %>
